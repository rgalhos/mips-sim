program = { line } ;

line = [ label ], [ statement ], [ comment ], "\n" ;

label = ( local_label | identifier ), ":" ;

local_label = ".", identifier ;

statement = instruction | directive ;

directive = directive_name, [ directive_operand, { [ "," ], directive_operand } ] ;

directive_name = ".", identifier ;

directive_operand = string_literal | number | identifier | register ;

instruction = mnemonic, [ operand, { [ "," ], operand } ] ;

comment = "#", { character } ;

mnemonic = identifier ;

operand = register | number | identifier | reloc_expr | reg_offset ;

reloc_expr = reloc_operator, "(", reloc_argument, ")" ;

reloc_operator = "%hi" | "%lo" | "%pcrel_hi" | "%pcrel_lo" ;

reloc_argument = identifier | number | local_label ;

reg_offset = ( reloc_expr | number ), "(", register, ")" ;

register =  "x0" | "x1" | "x2" | "x3" | "x4" | "x5" | "x6" | "x7" | "x8" | "x9" | "x10" | "x11" | "x12" | "x13" | "x14" | "x15" | "x16" | "x17" | "x18" | "x19" | "x20" | "x21" | "x22" | "x23" | "x24" | "x25" | "x26" | "x27" | "x28" | "x29" | "x30" | "x31" | "zero" | "ra" | "sp" | "gp" | "tp" | "t0" | "t1" | "t2" | "s0" | "s1" | "a0" | "a1" | "a2" | "a3" | "a4" | "a5" | "a6" | "a7" | "s2" | "s3" | "s4" | "s5" | "s6" | "s7" | "s8" | "s9" | "s10" | "s11" | "t3" | "t4" | "t5" | "t6" | "f0" | "f1" | "f2" | "f3" | "f4" | "f5" | "f6" | "f7" | "f8" | "f9" | "f10" | "f11" | "f12" | "f13" | "f14" | "f15" | "f16" | "f17" | "f18" | "f19" | "f20" | "f21" | "f22" | "f23" | "f24" | "f25" | "f26" | "f27" | "f28" | "f29" | "f30" | "f31" | "ft0" | "ft1" | "ft2" | "ft3" | "ft4" | "ft5" | "ft6" | "ft7" | "fs0" | "fs1" | "fa0" | "fa1" | "fa2" | "fa3" | "fa4" | "fa5" | "fa6" | "fa7" | "fs2" | "fs3" | "fs4" | "fs5" | "fs6" | "fs7" | "fs8" | "fs9" | "fs10" | "fs11" | "ft8" | "ft9" | "ft10" | "ft11" ;

string_literal = '"', { string_char }, '"' ;

string_char = qualquer caractere exceto '"' ou '\n' | escape_sequence ;

escape_sequence = "\", ( '"' | "\" | "n" | "t" | "r" ) ;

letter = "a" | ... | "z" | "A" | ... | "Z" ;

identifier = letter, { letter | digit | "_" | "." } ;

number = ["-"], ( dec_number | bin_number | hex_number | float_literal ) ;

dec_number = digit, { digit } ;

bin_number = "0b", bin_digit, { bin_digit } ;

hex_number = "0x", hex_digit, { hex_digit } ;

float_literal = dec_number, ".", dec_number ;

digit = "0" | ... | "9" ;

bin_digit = "0" | "1" ;

hex_digit = "0" | ... | "9" | "a" | ... | "f" ;
